# For one-off admin scripts run from your own computer (pnpm admin:create).
# Copy to .env in the repo root (git-ignored). Never put these in Vercel, CI or the website.

# Dashboard › Project Settings › API
SUPABASE_URL=https://your-project-ref.supabase.co
# Bypasses every security rule. Keep it on your computer only.
SUPABASE_SERVICE_ROLE_KEY=
# Password for quantumdigitaldentistry@gmail.com (10+ characters, upper and lower case,
# a number and a symbol). You can delete it from this file once the account exists.
SUPER_ADMIN_PASSWORD=
