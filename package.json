{
  "name": "quantam-dental",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "turbo run build",
    "preview": "pnpm --filter web preview",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:contrast": "pnpm --filter web check:contrast",
    "db:types": "supabase gen types typescript --linked > packages/supabase/src/database.types.ts",
    "admin:create": "node --env-file=.env scripts/create-super-admin.mjs",
    "check:secrets": "node scripts/check-secrets.mjs"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "supabase": "^2.118.0",
    "turbo": "^2.11.4"
  }
}
