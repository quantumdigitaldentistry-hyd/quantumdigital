# Secrets for the Edge Functions (book-appointment, team-invite, send-message).
#
# Local:      copy to supabase/functions/.env (git-ignored) and run
#             npx supabase functions serve --env-file supabase/functions/.env
# Production: set the same names in Supabase (never in git):
#             npx supabase secrets set --env-file supabase/functions/.env.production
#             or Dashboard › Edge Functions › Secrets.
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided by Supabase automatically;
# don't set them here.

# Website addresses allowed to call the functions (comma-separated, no trailing slash).
ALLOWED_ORIGINS=https://your-domain.com
# Used in links inside invite emails.
SITE_URL=https://your-domain.com
# Long random string; makes the booking rate-limit keys unguessable.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
RATE_LIMIT_SALT=

# New-appointment emails (Gmail SMTP). Leave SMTP_* empty to skip emails.
CLINIC_EMAIL=quantumdigitaldentistry@gmail.com
SMTP_USER=quantumdigitaldentistry@gmail.com
# Google app password (Google Account › Security › 2-Step Verification › App passwords),
# not the Gmail password.
SMTP_PASS=

# Optional: automatic confirmation SMS through MSG91 (needs DLT registration).
MSG91_AUTH_KEY=
MSG91_CONFIRM_TEMPLATE_ID=
