.env
.env.*
!.env.example
*.pem
*.key
*.jks
*.keystore
*.p8
*.p12
*service-account*.json
*serviceAccount*.json
*.mobileprovision
*.cer
credentials.json
google-services.json
GoogleService-Info.plist
service-account*.json

# ─────────────────────────────────────────────────────────────
# Dependencies
# ─────────────────────────────────────────────────────────────
node_modules/
.pnpm-store/

