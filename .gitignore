# ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Playwright MCP session output (snapshots, console logs)
.playwright-mcp/

