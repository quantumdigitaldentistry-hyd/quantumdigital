# ─────────────────────────────────────────────────────────────
.expo/
.expo-shared/
expo-env.d.ts
.kotlin/
*.orig.*
# Generated native folders (Continuous Native Generation — rebuilt by prebuild / EAS)
apps/*/ios/
apps/*/android/

# ─────────────────────────────────────────────────────────────
# Supabase CLI local state
# ─────────────────────────────────────────────────────────────
supabase/.temp/
supabase/.branches/

# ─────────────────────────────────────────────────────────────
# AI agent skills (third-party, restore with: npx skills experimental_install)
